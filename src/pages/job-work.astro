---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { siteConfig } from '../config/site';

const pageTitle = "Precision Job Work and Custom Manufacturing";
const pageDescription = "Subcontract machining and fabrication services: CNC turning, 10 to 75 ton press work, VMC milling, and wire fabrication based on customer drawings or samples.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Breadcrumbs crumbs={[{ name: 'Job Work', href: '/job-work' }]} />

  <section class="section section-paper">
    <div class="container">
      <div class="jobwork-hero-grid">
        <div class="jobwork-hero-info">
          <span class="eyebrow">SUBCONTRACT MANUFACTURING SERVICES</span>
          <h1 class="jobwork-title">Precision Job Work to Drawing or Sample</h1>
          <span class="red-rule"></span>
          <p class="jobwork-lead">
            We provide customer-specific subcontract machining, pressing, and fabrication for engineering OEMs, railway contractors, and electrical equipment builders from our Pithampur machine shop.
          </p>

          <div class="jobwork-actions">
            <a href="/contact" class="btn btn-primary">
              Send Drawing for Quotation
            </a>
            <a href="/manufacturing" class="btn btn-secondary">
              Review Machine Shop Bays
            </a>
          </div>
        </div>

        <div class="jobwork-hero-media">
          <ImageSlot imageKey="jobwork-drawing" alt="Engineering drawings and machined metal component on work table" aspectRatio="4 / 3" />
        </div>
      </div>
    </div>
  </section>

  <!-- Four Service Types -->
  <section class="section section-mist">
    <div class="container">
      <SectionHeading
        eyebrow="CAPABILITY SCOPE"
        title="Four Core Job Work Service Lines"
        subtitle="Manufactured using dedicated in-house machine tools with integrated surface finishing."
      />

      <div class="services-grid">
        {siteConfig.jobWork.services.map((svc) => (
          <div class="service-card card">
            <h3 class="service-title">{svc.name}</h3>
            <p class="service-details">{svc.details}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Information We Need Checklist -->
  <section class="section section-paper">
    <div class="container">
      <div class="checklist-card card">
        <div class="checklist-header">
          <span class="eyebrow">RFQ SPECIFICATION CHECKLIST</span>
          <h2>Information We Need to Provide a Fast, Accurate Quote</h2>
          <span class="red-rule"></span>
          <p class="checklist-intro">
            To evaluate tooling, cycle time, and material costs, please ensure your request includes the following four details:
          </p>
        </div>

        <div class="checklist-items">
          {siteConfig.jobWork.enquiryRequirements.map((item, idx) => (
            <div class="check-row">
              <span class="check-num">0{idx + 1}</span>
              <div class="check-text">
                <span class="check-title">{item}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="checklist-cta">
          <p>Have drawings ready in PDF, DXF, or STEP format?</p>
          <a href="/contact" class="btn btn-primary">
            Upload or Email Drawings to Our Engineering Desk
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .jobwork-hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .jobwork-title {
    font-size: var(--text-3xl);
    margin-top: 4px;
    margin-bottom: 0;
  }

  .jobwork-lead {
    font-size: var(--text-lg);
    color: var(--body);
    margin-bottom: 28px;
    line-height: 1.5;
  }

  .jobwork-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .service-card {
    padding: 28px;
  }

  .service-title {
    font-size: 20px;
    color: var(--ink);
    margin-bottom: 12px;
  }

  .service-details {
    font-size: 15px;
    color: var(--body);
    line-height: 1.5;
    margin-bottom: 0;
  }

  .checklist-card {
    padding: 40px;
    background-color: var(--mist);
  }

  .checklist-intro {
    font-size: 16px;
    color: var(--body);
    margin-bottom: 24px;
  }

  .checklist-items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 36px;
  }

  .check-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background-color: var(--paper);
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .check-num {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--red);
    line-height: 1;
    flex-shrink: 0;
  }

  .check-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.4;
  }

  .checklist-cta {
    text-align: center;
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }

  .checklist-cta p {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 16px;
  }

  @media (max-width: 900px) {
    .jobwork-hero-grid,
    .services-grid,
    .checklist-items {
      grid-template-columns: 1fr;
    }
    .checklist-card {
      padding: 24px;
    }
  }
</style>
