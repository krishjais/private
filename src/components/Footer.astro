---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer section-ink">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Summary -->
      <div class="footer-col footer-col-brand">
        <a href="/" class="footer-logo">
          <img src="/images/new-durga-logo.png" alt="" width="1536" height="1024" class="footer-logo-mark" />
          <span class="footer-brand-title">New Durga Wire Netting Work</span>
        </a>
        <p class="footer-description">
          {siteConfig.tagline}
        </p>
        <div class="footer-gst">
          <strong>GSTIN:</strong> <span>{siteConfig.gst}</span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-col">
        <h3 class="footer-heading">Navigation</h3>
        <ul class="footer-links">
          <li><a href="/products">Products Overview</a></li>
          <li><a href="/manufacturing">Machinery and Capabilities</a></li>
          <li><a href="/process">Manufacturing Process</a></li>
          <li><a href="/quality">Quality and Inspection</a></li>
          <li><a href="/job-work">Precision Job Work</a></li>
          <li><a href="/clients">Companies We Supply</a></li>
          <li><a href="/about">About the Company</a></li>
          <li><a href="/contact">Contact and RFQ</a></li>
        </ul>
      </div>

      <!-- Col 3: Products -->
      <div class="footer-col">
        <h3 class="footer-heading">Product Lines</h3>
        <ul class="footer-links">
          <li><a href="/products/railway-signal-relay-assembly">Railway Signal Relay Assembly</a></li>
          <li><a href="/products/relay-child-parts">Relay Child Parts</a></li>
          <li><a href="/products/coach-fan-guards">Coach Fan Guard (Mild Steel)</a></li>
          <li><a href="/products/coach-fan-guards">Coach Fan Guard (Stainless Steel)</a></li>
          <li><a href="/products/pillar-bush">Industrial Pillar Bush</a></li>
          <li><a href="/products/stainless-steel-bush">Stainless Steel Bush</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact Details -->
      <div class="footer-col">
        <h3 class="footer-heading">Works and Office</h3>
        <address class="footer-address">
          <p>{siteConfig.address.full}</p>
        </address>

        <div class="footer-contact-list">
          <div class="contact-entry">
            <strong>Phone Numbers:</strong>
            {siteConfig.phones.map((phone) => (
              <a
                href={`https://wa.me/${phone.replace(/[^0-9]/g, '')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-link"
                aria-label={`Message ${phone} on WhatsApp`}
              >{phone}</a>
            ))}
          </div>

          <div class="contact-entry">
            <strong>Email Addresses:</strong>
            {siteConfig.emails.map((email) => (
              <a href={`mailto:${email}`} class="contact-link">{email}</a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="footer-bottom">
      <div class="footer-copyright">
        <div>&copy; {currentYear} New Durga Wire Netting Work. All rights reserved.</div>
        <div class="footer-iso-text">ISO 9001:2015 certified quality management system</div>
      </div>
      <div class="footer-legal-links">
        <a href="/privacy-policy">Privacy Policy</a>
        <span class="legal-separator">|</span>
        <a href="/terms">Terms and Conditions</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: 64px;
    padding-bottom: 32px;
    border-top: 3px solid var(--red);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr 1.8fr;
    gap: 40px;
    margin-bottom: 48px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    text-decoration: none;
  }

  .footer-logo-mark {
    width: 44px;
    height: 44px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .footer-brand-title {
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 700;
    color: var(--paper);
  }

  .footer-description {
    font-size: 14px;
    color: var(--line);
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .footer-gst {
    font-size: 13px;
    color: var(--line);
  }

  .footer-gst strong {
    color: var(--paper);
  }

  .footer-heading {
    font-size: 16px;
    font-weight: 700;
    color: var(--paper);
    margin-bottom: 16px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    font-size: 14px;
    color: var(--line);
    transition: color var(--transition);
  }

  .footer-links a:hover {
    color: var(--paper);
    text-decoration: underline;
  }

  .footer-address {
    font-style: normal;
    font-size: 14px;
    color: var(--line);
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 13px;
  }

  .contact-entry {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .contact-entry strong {
    color: var(--paper);
    font-size: 13px;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--line);
    transition: color var(--transition);
  }

  .contact-link:hover {
    color: var(--paper);
  }

  .footer-bottom {
    border-top: 1px solid rgba(217, 220, 227, 0.15);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--line);
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer-copyright {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer-iso-text {
    font-size: 12px;
    color: rgba(217, 220, 227, 0.7);
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-legal-links a {
    color: var(--line);
    transition: color var(--transition);
  }

  .footer-legal-links a:hover {
    color: var(--paper);
  }

  .legal-separator {
    color: rgba(217, 220, 227, 0.3);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 36px;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
