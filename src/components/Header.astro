---
import { siteConfig } from '../config/site';

const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Products', href: '/products' },
  { name: 'Manufacturing', href: '/manufacturing' },
  { name: 'Process', href: '/process' },
  { name: 'Quality', href: '/quality' },
  { name: 'Job Work', href: '/job-work' },
  { name: 'Clients', href: '/clients' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' }
];
---

<header class="site-header">
  <!-- Top Utility Bar -->
  <div class="utility-bar">
    <div class="container utility-content">
      <div class="utility-location">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" class="utility-icon">
          <path d="M 21 10 C 21 17 12 23 12 23 C 12 23 3 17 3 10 C 3 5 7 1 12 1 C 17 1 21 5 21 10 Z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <span>{siteConfig.address.short}</span>
      </div>

      <div class="utility-contacts">
        <a href={`tel:${siteConfig.phones[0].replace(/\s+/g, '')}`} class="utility-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" class="utility-icon">
            <path d="M 22 16.92 V 19.92 C 22 20.48 21.54 20.94 20.97 20.92 C 11.58 20.52 4 12.94 3.6 3.55 C 3.58 2.98 4.04 2.52 4.6 2.52 H 7.6 C 8.1 2.52 8.53 2.87 8.62 3.36 C 8.78 4.23 9.06 5.07 9.44 5.86 C 9.58 6.16 9.5 6.52 9.26 6.76 L 7.55 8.47 C 9.04 11.43 11.57 13.96 14.53 15.45 L 16.24 13.74 C 16.48 13.5 16.84 13.42 17.14 13.56 C 17.93 13.94 18.77 14.22 19.64 14.38 C 20.13 14.47 20.48 14.9 20.48 15.4 V 16.92 Z" />
          </svg>
          <span>{siteConfig.phones[0]}</span>
        </a>

        <a href={`mailto:${siteConfig.emails[0]}`} class="utility-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" class="utility-icon">
            <path d="M 4 4 H 20 C 21.1 4 22 4.9 22 6 V 18 C 22 19.1 21.1 20 20 20 H 4 C 2.9 20 2 19.1 2 18 V 6 C 2 4.9 2.9 4 4 4 Z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
          <span>{siteConfig.emails[0]}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="nav-bar">
    <div class="container nav-content">
      <a href="/" class="brand-logo">
        <span class="logo-mark">
          <img src="/images/new-durga-logo.png" alt="" width="1536" height="1024" />
        </span>
        <span class="brand-text">
          <span class="brand-name">New Durga Wire</span>
          <span class="brand-sub">Netting Work : Estd 2010</span>
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="desktop-nav" aria-label="Primary Navigation">
        <ul class="nav-list">
          {navLinks.map((link) => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <li>
                <a href={link.href} class={`nav-item ${isActive ? 'is-active' : ''}`}>
                  {link.name}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <!-- Desktop Quote CTA Button -->
      <div class="nav-actions">
        <a href="/contact" class="btn btn-primary nav-quote-btn">
          Get a Quote
        </a>

        <!-- Mobile Nav Hamburger Button -->
        <button
          type="button"
          id="mobile-nav-toggle"
          class="mobile-toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="icon-menu">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="icon-close" style="display: none;">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--paper);
    box-shadow: 0 1px 2px rgba(20, 23, 31, 0.06);
  }

  .utility-bar {
    background-color: var(--ink);
    color: var(--line);
    font-size: 13px;
    padding: 6px 0;
    border-bottom: 1px solid rgba(217, 220, 227, 0.15);
  }

  .utility-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .utility-location,
  .utility-contacts {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .utility-icon {
    color: var(--red);
    flex-shrink: 0;
  }

  .utility-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--line);
    transition: color var(--transition);
  }

  .utility-link:hover {
    color: var(--paper);
  }

  .nav-bar {
    background-color: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .nav-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 84px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .logo-mark {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    overflow: hidden;
  }

  .logo-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.1;
  }

  .brand-sub {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--body);
    letter-spacing: 0.05em;
  }

  .desktop-nav {
    display: flex;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-item {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    padding: 8px 12px;
    border-radius: var(--radius);
    transition: color var(--transition), background-color var(--transition);
  }

  .nav-item:hover {
    color: var(--blue);
    background-color: var(--mist);
  }

  .nav-item.is-active {
    color: var(--red);
    border-bottom: 2px solid var(--red);
    border-radius: 0;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav-quote-btn {
    min-height: 40px;
    padding: 0 18px;
    font-size: 15px;
  }

  .mobile-toggle {
    display: none;
    padding: 8px;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  @media (max-width: 1024px) {
    .desktop-nav,
    .nav-quote-btn {
      display: none;
    }
    .mobile-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .utility-location {
      display: none;
    }
    .utility-content {
      justify-content: flex-end;
    }
  }

  @media (max-width: 640px) {
    .utility-bar {
      display: none;
    }
  }
</style>
